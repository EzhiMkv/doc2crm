# Скопируй в .env и заполни своими значениями.
# ВНИМАНИЕ: .env не коммитится — webhook URL это, по сути, пароль к CRM.

# Входящий вебхук Битрикс24 (Маркет → Разработчикам → Интеграции), права: CRM
B24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/your_token_here/

# LLM-провайдер: deepseek | gigachat | yandexgpt | vllm (OpenAI-совместимый API)
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Telegram-бот (@BotFather)
TELEGRAM_BOT_TOKEN=
