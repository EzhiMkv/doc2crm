# Скопируй в .env и заполни своими значениями.
# ВНИМАНИЕ: .env не коммитится — webhook URL это, по сути, пароль к CRM.

# Входящий вебхук Битрикс24 (Маркет → Разработчикам → Интеграции), права: CRM
B24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/your_token_here/

# LLM-провайдер (OpenAI-совместимый API): HF Router / OpenRouter / DeepSeek / GigaChat / vLLM
# Пример: HuggingFace Router (бесплатные кредиты, vision-модели)
LLM_PROVIDER=hf-router
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=hf_...
LLM_MODEL=google/gemma-3-12b-it
LLM_FALLBACK_MODELS=

# Telegram-бот (@BotFather)
TELEGRAM_BOT_TOKEN=
